# Perception demo stack (traversability_seg_ros2/docker/perception_jetson):
# YOLO + segmentation + lidar objects + fusion + safety zones + Foxglove
# bridge (ws://<tractor>:8765) in the perception-jetson:humble container.
# Only in demo mode (tractor-mode demo), which also runs the bringup with
# tf:=false (this stack publishes TF from its own calibration).
[Unit]
Description=Perception demo stack (Docker perception-jetson:humble, live_stack.sh)
After=docker.service ros2-publishers-boot.service
Requires=docker.service
Wants=ros2-publishers-boot.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=user
# optional: PERCEPTION_RIG=<rig yaml inside the container> selects the
# calibration (empty = rig_vario700_msa_new_live.yaml), see docs/OPERATIONS.md
EnvironmentFile=-/etc/tractor/perception.env
ExecStartPre=-/usr/bin/docker rm -f perception
ExecStart=/usr/bin/docker run --rm --name perception --runtime nvidia --network host --ipc host \
  --stop-signal SIGINT --stop-timeout 20 \
  -e RIG=${PERCEPTION_RIG} \
  -v /mnt/perception/models:/root/ros2_ws/models:ro \
  -v perception_trt_cache:/root/.cache \
  -v /mnt/perception/docker/perception_jetson:/config:ro \
  perception-jetson:humble /config/live_stack.sh foxglove:=true
# ros2 launch shuts down cleanly on SIGINT (Ctrl+C); docker kills after 20 s
ExecStop=/usr/bin/docker stop perception
TimeoutStopSec=30
SuccessExitStatus=130 137 143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
